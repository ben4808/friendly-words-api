{
  "name": "friendly-words-api",
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "prebuild": "npm run build --prefix ../cruzi-models && npm run build --prefix ../cruzi-db",
    "build": "tsc",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cruzi-db": "file:../cruzi-db",
    "cruzi-models": "file:../cruzi-models",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
